; The zone, as a desktop client sees it.
;
; No headset. `XRGridFlatscreenController` drives a camera and two hands from mouse, WASD and a
; gamepad, and it is the engine's own — the same class the XR build falls back to when no
; runtime is initialised, so this is not a test double. What it moves are three Node3Ds, which
; is exactly what a head and two hands are on the wire, so the client above them cannot tell
; the difference and neither can the service.
;
; The node names are the controller's contract, not a preference: it looks up `XRCamera3D`,
; `hand_left` and `hand_right` under its parent by name, and silently drives nothing if they are
; renamed. `XRCamera3D` is a plain Camera3D here — the controller casts to Camera3D and never
; asks for an XR one, so the desktop build needs no XR node in the tree at all.
[gd_scene load_steps=6 format=3 uid="uid://bzone00000001"]

[ext_resource type="Script" path="res://scripts/zone_client.gd" id="1_client"]
[ext_resource type="Script" path="res://scripts/local_rig.gd" id="2_rig"]

[sub_resource type="PlaneMesh" id="Mesh_floor"]
size = Vector2(200, 200)

[sub_resource type="StandardMaterial3D" id="Mat_floor"]
albedo_color = Color(0.14, 0.15, 0.17, 1)
roughness = 0.95

[sub_resource type="Environment" id="Env"]
background_mode = 1
background_color = Color(0.05, 0.06, 0.08, 1)
ambient_light_source = 2
ambient_light_color = Color(0.5, 0.55, 0.65, 1)
ambient_light_energy = 0.6

[node name="Zone" type="Node3D"]

[node name="WorldEnvironment" type="WorldEnvironment" parent="."]
environment = SubResource("Env")

[node name="Sun" type="DirectionalLight3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 0.7, 0.7, 0, -0.7, 0.7, 0, 12, 0)
shadow_enabled = true

; The floor is the client's own, not an entity. The service simulates a plane it never sends,
; because a static collider costs a packet every tick and moves for nobody.
[node name="Floor" type="MeshInstance3D" parent="."]
mesh = SubResource("Mesh_floor")
surface_material_override/0 = SubResource("Mat_floor")

; Everything the service says exists is parented here, and nothing else is.
[node name="World" type="Node3D" parent="."]

[node name="ZoneClient" type="Node" parent="."]
script = ExtResource("1_client")
world_path = NodePath("../World")

; Stands in for the XR origin: a body at eye height with two hands in front of it. The names
; below are what XRGridFlatscreenController looks for.
[node name="Rig" type="Node3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0, 4)

[node name="XRCamera3D" type="Camera3D" parent="Rig"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 1.6, 0)
near = 0.05
far = 4000.0

[node name="hand_left" type="Node3D" parent="Rig"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -0.25, 1.1, -0.4)

[node name="hand_right" type="Node3D" parent="Rig"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0.25, 1.1, -0.4)

[node name="Flatscreen" type="XRGridFlatscreenController" parent="Rig"]

[node name="LocalRig" type="Node3D" parent="."]
script = ExtResource("2_rig")
zone_client_path = NodePath("../ZoneClient")
head_path = NodePath("../Rig/XRCamera3D")
left_hand_path = NodePath("../Rig/hand_left")
right_hand_path = NodePath("../Rig/hand_right")
